# qseries_battery.mpl -- Maple-parity battery for qseries-sage (generated by parity/make_maple.py; seed 20261106)
# Run in Maple with Garvan's qseries package available:   read "qseries_battery.mpl";
# Output: maple_results.txt in the current directory (see currentdir()). About 130 cases.
interface(warnlevel = 0):
with(qseries):
S := proc(f, T) convert(series(f, q, T), polynom) end proc:
CL := proc(f, a, b) local g, i; g := expand(f); [seq(coeff(g, q, i), i = a .. b)] end proc:
POCH := proc(a, b, T) local k; mul(1 - q^(a + b*k), k = 0 .. floor((T - 1 - a)/b)) end proc:
JS := proc(a, b, T) if a = 0 then POCH(b, b, T) else POCH(a, b, T)*POCH(b - a, b, T)*POCH(b, b, T) end if end proc:
E4S := proc(T) local n; 1 + 240*add(numtheory[sigma][3](n)*q^n, n = 1 .. T - 1) end proc:
E6S := proc(T) local n; 1 - 504*add(numtheory[sigma][5](n)*q^n, n = 1 .. T - 1) end proc:
UE := proc(k, p, T) local m, n; add(add(numtheory[jacobi](m, p)*n^(k - 1)*q^(m*n), n = 1 .. floor(T/m)), m = 1 .. T) end proc:
fd := fopen("maple_results.txt", WRITE, TEXT):
fprintf(fd, "# maple\t%s\n", StringTools:-SubstituteAll(convert(kernelopts(version), string), "\n", " ")):
try fprintf(fd, "# qseries\t%s\n", StringTools:-SubstituteAll(sprintf("%a", [packageversion()]), "\n", " ")) catch: fprintf(fd, "# qseries\t?\n") end try:
fprintf(fd, "# seed\t20261106\n"):
WR := proc(id, t) local r; r := [args[3 .. -1]]; r := `if`(nops(r) = 0, NULL_RESULT, `if`(nops(r) = 1, r[1], r)); fprintf(fd, "%s\t%s\t%.2f\n", id, StringTools:-SubstituteAll(StringTools:-SubstituteAll(StringTools:-SubstituteAll(sprintf("%a", r), "\n", ""), "\t", " "), "NULL_RESULT", "NULL"), time() - t) end proc:
WE := proc(id, t) fprintf(fd, "%s\tERROR %s\t%.2f\n", id, StringTools:-SubstituteAll(StringTools:-FormatMessage(lastexception[2 .. -1]), "\n", " "), time() - t) end proc:

